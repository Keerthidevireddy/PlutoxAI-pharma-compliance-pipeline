# ═══════════════════════════════════════════════════════════════════════
#  Pharma Compliance Pipeline - Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Get your Anthropic API key from: https://console.anthropic.com
# 3. Replace the ANTHROPIC_API_KEY value below with your actual key
# 4. (Optional) Adjust other settings as needed
#
# ═══════════════════════════════════════════════════════════════════════

# ── LLM Configuration (Required) ──────────────────────────────────────

# Your Anthropic API key
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model to use
# Options: claude-opus-4-7 (most capable), claude-sonnet-4-6 (faster), claude-haiku-4-5 (cheapest)
# Default: claude-opus-4-7
LLM_MODEL=claude-opus-4-7

# Maximum tokens per LLM response
# Default: 4096
LLM_MAX_TOKENS=4096

# LLM temperature (0.0 = deterministic, 1.0 = creative)
# For compliance validation, use 0.0 for consistency
# Default: 0.0
LLM_TEMPERATURE=0.0

# ── Embedding Configuration (Optional) ────────────────────────────────

# Sentence Transformers model for document embeddings
# Default: all-MiniLM-L6-v2 (lightweight, fast, good quality)
# Alternatives: all-mpnet-base-v2 (slower but more accurate)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Storage Configuration (Optional) ──────────────────────────────────

# ChromaDB persistence directory (relative to project root)
# Default: outputs/chroma_db
CHROMA_PERSIST_DIR=outputs/chroma_db

# Directory for outputs (reports, plots, logs)
# Default: outputs
OUTPUTS_DIR=outputs

# ══════════════════════════════════════════════════════════════════════
# That's it! Save this file as .env and you're ready to run the pipeline
# ══════════════════════════════════════════════════════════════════════
